# Documentation only. Node/DSH does not load this file automatically.
# Keep actual secrets outside the checkout. The default is closed.
DAFEIYU_DSH_POLICY_FILE=/absolute/path/outside-checkout/policy.json
# Optional: configure BOTH to use your own capability backend.
# DAFEIYU_HUB_URL=https://hub.example.com
# DAFEIYU_HUB_TOKEN_FILE=/absolute/path/outside-checkout/bridge-token
# Exact HTTPS origin permitted in model replies; no wildcard.
DAFEIYU_WEBSITE_ORIGIN=https://example.com
# Optional join events require app/platform permissions as well.
DAFEIYU_OFFICIAL_JOIN_EVENTS=0
DAFEIYU_ENROLLMENT_DIAGNOSTICS=0
